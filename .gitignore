# ── Python ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ── Virtual Environments ───────────────────────────────────────────
.venv
env/
venv/
ENV/
backend/venv/
backend/.venv

# ── Jupyter ────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── Secrets & Credentials (CRITICAL — must never be committed) ─────
# All .env files are excluded by default
**/.env
**/.env.local
**/.env.*.local
*.pem
*.key
secrets/
credentials.json
service_account.json
# Explicitly allow ONLY .env.example placeholder files
!backend/.env.example
!frontend/.env.example

# ── SQLite development database & local artifacts ──────────────────
*.db
*.sqlite
*.sqlite3

# ── Debug & temporary files ─────────────────────────────────────────
*_debug.txt
*.debug
fix/

# ── Alembic ────────────────────────────────────────────────────────
# Keep migrations directory but ignore cache
backend/app/db/migrations/__pycache__/

# ── OS & IDE ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ── Node.js / Frontend ────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/.env.local
frontend/.env.*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Logs & Outputs ────────────────────────────────────────────────
logs/
*.log
mlruns/
wandb/
outputs/

# ── Test & Coverage ───────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ── Docker ────────────────────────────────────────────────────────
# Keep Dockerfile and docker-compose.yml — exclude runtime volumes
docker-volumes/
