[32m+[m
[32m+[m[32m```python[m
[32m+[m[32m# backend/app/routes/auth.py[m
[32m+[m[32mfrom fastapi import APIRouter, Depends, HTTPException, status[m
[32m+[m[32mfrom fastapi.security import OAuth2PasswordBearer, OAuth2PasswordRequestForm[m
[32m+[m[32mfrom jose import JWTError, jwt[m
[32m+[m[32mfrom passlib.context import CryptContext[m
[32m+[m[32mfrom datetime import datetime, timedelta[m
[32m+[m[32mfrom typing import Optional[m
[32m+[m[32mimport secrets[m
[32m+[m
[32m+[m[32mfrom app.schemas.auth import ([m
[32m+[m[32m    UserRegistration, UserLogin, TokenResponse, UserProfile[m
[32m+[m[32m)[m
[32m+[m[32mfrom app.db.models import User[m
[32m+[m[32mfrom app.config import settings[m
[32m+[m
[32m+[m[32mrouter = APIRouter(prefix="/api/auth", tags=["Authentication"])[m
[32m+[m
[32m+[m[32mpwd_context = CryptContext(schemes=["bcrypt"], deprecated="auto")[m
[32m+[m[32moauth2_scheme = OAuth2PasswordBearer(tokenUrl="/api/auth/token")[m
[32m+[m
[32m+[m[32mdef create_access_token(data: dict, expires_delta: Optional[timedelta] = None):[m
[32m+[m[32m    to_encode = data.copy()[m
[32m+[m[32m    expire = datetime.utcnow() + (expires_delta or timedelta(minutes=15))[m
[32m+[m[32m    to_encode.update({"exp": expire})[m
[32m+[m[32m    return jwt.encode(to_encode, settings.SECRET_KEY, algorithm="HS256")[m
[32m+[m
[32m+[m[32mdef create_refresh_token():[m
[32m+[m[32m    return secrets.token_urlsafe(32)[m
[32m+[m
[32m+[m[32m@router.post("/register", response_model=TokenResponse)[m
[32m+[m[32masync def register_user(user_data: UserRegistration):[m
[32m+[m[32m    """[m
[32m+[m[32m    Register a new CHW or supervisor account.[m
[32m+[m[32m    Admin approval required for supervisor/admin roles.[m
[32m+[m[32m    """[m
[32m+[m[32m    # Check if email exists[m
[32m+[m[32m    existing_user = await User.get_by_email(user_data.email)[m
[32m+[m[32m    if existing_user:[m
[32m+[m[32m        raise HTTPException([m
[32m+[m[32m            status_code=status.HTTP_400_BAD_REQUEST,[m
[32m+[m[32m            detail="Email already registered"[m
[32m+[m[32m        )[m
[32m+[m[41m    [m
[32m+[m[32m    # Hash password[m
[32m+[m[32m    hashed_password = pwd_context.hash(user_data.password)[m
[32m+[m[41m    [m
[32m+[m[32m    # Create user[m
[32m+[m[32m    new_user = await User.create([m
[32m+[m[32m        email=user_data.email,[m
[32m+[m[32m        hashed_password=hashed_password,[m
[32m+[m[32m        full_name=user_data.full_name,[m
[32m+[m[32m        role=user_data.role,[m
[32m+[m[32m        facility_id=user_data.facility_id,[m
[32m+[m[32m        region=user_data.region,[m
[32m+[m[32m        is_active=True if user_data.role == "chw" else False  # Supervisors need approval[m
[32m+[m[32m    )[m
[32m+[m[41m    [m
[32m+[m[32m    # Generate tokens[m
[32m+[m[32m    access_token = create_access_token([m
[32m+[m[32m        data={"sub": new_user.id, "role": new_user.role},[m
[32m+[m[32m        expires_delta=timedelta(hours=24)[m
[32m+[m[32m    )[m
[32m+[m[32m    refresh_token = create_refresh_token()[m
[32m+[m[41m    [m
[32m+[m[32m    # Store refresh token in database[m
[32m+[m[32m    await User.update_refresh_token(new_user.id, refresh_token)[m
[32m+[m[41m    [m
[32m+[m[32m    return TokenResponse([m
[32m+[m[32m        access_token=access_token,[m
[32m+[m[32m        refresh_token=refresh_token,[m
[32m+[m[32m        expires_in=86400,  # 24 hours[m
[32m+[m[32m        user=UserProfile.from_orm(new_user)[m
[32m+[m[32m    )[m
