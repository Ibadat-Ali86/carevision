[32m+[m[32m  isLoading: boolean[m
[32m+[m[41m  [m
[32m+[m[32m  // Actions[m
[32m+[m[32m  login: (email: string, password: string) => Promise<void>[m
[32m+[m[32m  logout: () => void[m
