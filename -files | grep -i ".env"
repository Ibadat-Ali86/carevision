[32m+[m[32m  tokens: Dexie.Table<{ key: string; value: string }, string>[m
[32m+[m
[32m+[m[32m  constructor() {[m
[32m+[m[32m    super('CareVisionAuth')[m
[32m+[m[32m    this.version(1).stores({[m
[32m+[m[32m      tokens: 'key',[m
[32m+[m[32m    })[m
[32m+[m[32m    this.tokens = this.table('tokens')[m
[32m+[m[32m  }[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32mconst authDB = new AuthDB()[m
[32m+[m
[32m+[m[32mexport const useAuthStore = create<AuthState>()([m
[32m+[m[32m  persist([m
[32m+[m[32m    (set, get) => ({[m
[32m+[m[32m      user: null,[m
[32m+[m[32m      accessToken: null,[m
[32m+[m[32m      refreshToken: null,[m
[32m+[m[32m      isAuthenticated: false,[m
[32m+[m[32m      isLoading: false,[m
[32m+[m
[32m+[m[32m      login: async (email: string, password: string) => {[m
[32m+[m[32m        set({ isLoading: true })[m
[32m+[m[32m        try {[m
[32m+[m[32m          const response = await fetch('/api/auth/token', {[m
[32m+[m[32m            method: 'POST',[m
