[32m+[m[32m### 2.2 Frontend Authentication State Management[m
[32m+[m
[32m+[m[32m```tsx[m
[32m+[m[32m// src/store/authStore.ts[m
[32m+[m[32mimport { create } from 'zustand'[m
[32m+[m[32mimport { persist } from 'zustand/middleware'[m
[32m+[m[32mimport Dexie from 'dexie'[m
[32m+[m
[32m+[m[32minterface User {[m
[32m+[m[32m  id: string[m
