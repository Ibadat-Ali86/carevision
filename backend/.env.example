
# ── AI Model ──────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMMA_MODEL=gemini-2.0-flash
GEMMA_MAX_RETRIES=2
GEMMA_TIMEOUT_SECONDS=30

# ── Database ──────────────────────────────────────────────────────

DATABASE_URL=sqlite+aiosqlite:///./carevision.db

# ── Cloudflare R2 Image Storage (optional — storage is non-fatal if absent) ──
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY=your_r2_access_key
R2_SECRET_KEY=your_r2_secret_key
R2_BUCKET=carevision
R2_PUBLIC_URL=

# ── Observability ─────────────────────────────────────────────────
LOGFIRE_TOKEN=

# ── CORS ─────────────────────────────────────────────────────────
# JSON array of allowed frontend origins
ALLOWED_ORIGINS=["http://localhost:5173"]

# ── Runtime ───────────────────────────────────────────────────────
ENVIRONMENT=development

# ── Security (JWT) ────────────────────────────────────────────────

SECRET_KEY=change-me-to-a-random-32-byte-hex-string-before-deploying
