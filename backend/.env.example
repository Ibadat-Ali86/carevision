# Backend environment variables — copy to .env and fill in real values
# NEVER commit the .env file. This template is safe to commit.

# ── AI Model ──────────────────────────────────────────────────────
GEMMA_API_KEY=your_gemma_api_key_here
GEMMA_MODEL=gemini-2.0-flash-exp
GEMMA_MAX_RETRIES=2
GEMMA_TIMEOUT_SECONDS=30

# ── Database ──────────────────────────────────────────────────────
# Production (Neon PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?sslmode=require
# Development (SQLite — no external service required):
DATABASE_URL=sqlite+aiosqlite:///./carevision.db

# ── Cloudflare R2 Image Storage (optional — storage is non-fatal if absent) ──
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY=your_r2_access_key
R2_SECRET_KEY=your_r2_secret_key
R2_BUCKET=carevision
R2_PUBLIC_URL=

# ── Observability ─────────────────────────────────────────────────
LOGFIRE_TOKEN=

# ── CORS ─────────────────────────────────────────────────────────
# JSON array of allowed frontend origins
# SECURITY: In production, only use HTTPS origins. Wildcards (*) are NOT allowed.
ALLOWED_ORIGINS=["http://localhost:5173"]

# ── Runtime ───────────────────────────────────────────────────────
ENVIRONMENT=development

# ── Security ─────────────────────────────────────────────────────
# Device authentication secret key (REQUIRED for production)
# Generate with: openssl rand -hex 32
# This key is used to sign and verify device tokens
DEVICE_AUTH_SECRET_KEY=your_32_char_secret_key_here_change_in_production

# Rate limiting configuration
# Format: {count}/{period} where period is second, minute, hour, day
RATE_LIMIT_DEFAULT=10/minute
RATE_LIMIT_ANALYZE=5/minute

# Maximum request size in bytes (default: 10MB)
MAX_REQUEST_SIZE=10485760

# ── Audit Logging ─────────────────────────────────────────────────
# Enable audit logging for HIPAA compliance (recommended: true in production)
AUDIT_LOG_ENABLED=true
